# Cloud configuration. For local no-cloud mode, leave GCP_PROJECT blank.
GCP_PROJECT=
GCP_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true
ADK_APP_NAME=tracewell_incident_copilot
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LOOKBACK_MINUTES=30
MAX_AGENT_STEPS=18
TRACEWELL_LOCAL_FALLBACK=true
TRACEWELL_ALLOW_AGENT_FALLBACK=true
# Optional explicit URL for local/dev health checks
PAYMENT_API_URL=
